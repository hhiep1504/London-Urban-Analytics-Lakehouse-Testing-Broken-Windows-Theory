# ADLS Gen2 account name only; do not include a URL or access key.
AZURE_STORAGE_ACCOUNT=your_storage_account

# Containers used by the public notebooks.
AZURE_RAW_CONTAINER=raw
AZURE_SILVER_CONTAINER=silver
AZURE_GOLD_CONTAINER=gold

# Optional paths inside each container.
AZURE_RAW_PREFIX=
AZURE_SILVER_PREFIX=
AZURE_GOLD_PREFIX=
